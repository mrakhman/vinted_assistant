# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI API key. Leave empty and set DRY_RUN=1 to test everything
# except the model call.
OPENAI_API_KEY=

# Set to 1 to run with canned answers and no API key.
DRY_RUN=1

# Telegram user IDs allowed to use the bot, space- or comma-separated.
# Leave empty to allow anyone (don't — it spends your API credit).
# The bot tells an unknown user their own ID, so you can self-serve this.
ALLOWED_USER_IDS=

# Confirm the exact ID against your own account before the first real run:
#   .venv/bin/python -c "from openai import OpenAI; \
#     print([m.id for m in OpenAI().models.list() if 'gpt' in m.id])"
# Must be a model that accepts images and supports structured outputs.
OPENAI_MODEL=gpt-5.5

# Only used for the cost line in the logs. USD per million tokens.
PRICE_IN_PER_MTOK=5
PRICE_OUT_PER_MTOK=30

# Where the item list lives. Delete the file to start fresh.
ITEMS_PATH=items.json

# Running cost tally. Delete the file to reset it.
USAGE_PATH=usage.json
